{
  "manifest_version": 3,
  "name": "VibeResume 网申助手",
  "version": "0.9.0",
  "description": "在本地保存简历资料，并自动填写常见招聘网站的网申表单。",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "VibeResume 网申助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["field-rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
